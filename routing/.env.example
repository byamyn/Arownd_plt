# Public DNS name pointing to this server
ROUTING_DOMAIN=routing.example.com

# Geofabrik extracts for Arownd current markets: Algeria, Morocco, Egypt, Saudi Arabia and UAE.
# The GCC extract contains Saudi Arabia and UAE. Valhalla scripted supports multiple PBF URLs;
# validate memory use and routes at market boundaries before production.
OSM_PBF_URLS=https://download.geofabrik.de/africa/algeria-latest.osm.pbf https://download.geofabrik.de/africa/morocco-latest.osm.pbf https://download.geofabrik.de/africa/egypt-latest.osm.pbf https://download.geofabrik.de/asia/gcc-states-latest.osm.pbf

# Pin this to a tested Valhalla image tag or digest before production.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
