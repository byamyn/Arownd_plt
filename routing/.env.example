# Public DNS name pointing to this server
ROUTING_DOMAIN=routing.example.com

# Geofabrik extract used to build the initial road graph.
# For additional Arownd markets, replace this with a tested regional extract strategy.
OSM_PBF_URL=https://download.geofabrik.de/africa/algeria-latest.osm.pbf

# Pin this to a tested Valhalla image tag or digest before production.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
