{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_CAPTCHA_ENABLED": "true",
        "EXPO_PUBLIC_AUTH_CAPTCHA_CUSTOM_SIGNUP": "true"
      },
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_CAPTCHA_ENABLED": "true",
        "EXPO_PUBLIC_AUTH_CAPTCHA_CUSTOM_SIGNUP": "true"
      }
    }
  }
}
